<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Typotrainer.Views.PageOefening">

    <VerticalStackLayout Style="{StaticResource Oefenpagina}">

        <!-- STATISTIEKEN -->
        <HorizontalStackLayout>
            <Frame>
                <HorizontalStackLayout>
                    <Image Source="zap.png" Style="{StaticResource Icon}" />
                    <Label x:Name="SnelheidLabel" Text="Snelheid:&#10;0 WPM"/>
                </HorizontalStackLayout>
            </Frame>

            <Frame>
                <HorizontalStackLayout>
                    <Image Source="target.png" Style="{StaticResource Icon}" />
                    <Label x:Name="NauwkeurigheidLabel" Text="Nauwkeurigheid:&#10;100.0%"/>
                </HorizontalStackLayout>
            </Frame>

            <Frame>
                <HorizontalStackLayout>
                    <Image Source="clock.png" Style="{StaticResource Icon}" />
                    <Label x:Name="TimerLabel" Text="Tijd:&#10;00:00"/>
                </HorizontalStackLayout>
            </Frame>
        </HorizontalStackLayout>

        <!-- OEFENING -->
        <Frame WidthRequest="500">
            <VerticalStackLayout Style="{StaticResource Oefening}">

                <Label x:Name="CorrectText" Style="{StaticResource Text18}" />
                <Label x:Name="ColoredOutput" Style="{StaticResource Text18}" />

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Label x:Name="FoutenCount" Text="Fouten: 0" Style="{StaticResource Text18}"/>
                    <Label x:Name="OefeningenCount" Text="Oefeningen: 0/10" Style="{StaticResource Text18}"/>
                </HorizontalStackLayout>

                <!-- MOEILIJKHEIDS KNOPPEN -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button x:Name="EasyButton"
                            Text="Makkelijk"
                            Clicked="Easy_Clicked"
                            Style="{StaticResource OefeningStart}" />

                    <Button x:Name="MediumButton"
                            Text="Gemiddeld"
                            Clicked="Medium_Clicked"
                            Style="{StaticResource OefeningStart}" />

                    <Button x:Name="HardButton"
                            Text="Moeilijk"
                            Clicked="Hard_Clicked"
                            Style="{StaticResource OefeningStart}" />
                </HorizontalStackLayout>

                <!-- START/PAUZE -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button x:Name="StartButton"
                            Text="Start oefening"
                            Clicked="Startknop_Clicked"
                            Style="{StaticResource OefeningStart}" />

                    <Button x:Name="PauseButton"
                            Text="Pauzeer"
                            Clicked="Pauzeknop_Clicked"
                            Style="{StaticResource OefeningStart}"
                            IsVisible="False"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <!-- ONZICHTBARE EDITOR -->
        <Editor x:Name="InputEditor"
                TextChanged="InputEditor_TextChanged"
                Style="{StaticResource OefeningEditor}"/>

    </VerticalStackLayout>

</ContentView>
